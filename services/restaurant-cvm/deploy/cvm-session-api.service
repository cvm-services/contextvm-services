# Session API — the edge authorization service (loopback only; Caddy proxies in).
# Secrets arrive as environment variables materialised from OpenBao at start; no
# token ever lives on disk in a unit file.
[Unit]
Description=CVM session API (captcha handoff)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cvm
Group=cvm
WorkingDirectory=/opt/cvm/services/restaurant-cvm
# deno on the target is /usr/local/bin/deno, not /usr/bin. systemd cannot expand
# EnvironmentFile vars in ExecStart, so this path is literal and must be right.
EnvironmentFile=/etc/cvm/session-api.env
# Loopback only: the service must never be reachable except through Caddy.
Environment=CVM_SESSION_API_PORT=8791
Environment=CVM_SESSION_STORE=/var/lib/cvm/sessions.json
ExecStartPre=/usr/bin/install -d -o cvm -g cvm -m 0750 /var/lib/cvm
ExecStart=/usr/local/bin/deno run --allow-net=127.0.0.1 --allow-env --allow-read=/etc/cvm --allow-write=/var/lib/cvm --allow-run=node \
  src/serve.ts
Restart=on-failure
RestartSec=3

# Hardening: this process needs no shell, no home, no new privileges.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cvm
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target

# Non-secret configuration for the x280 customer API.
# Copy to /etc/cvm/customer-api.env (0600 root). The two secrets resolve from
# OpenBao at start; never put CVM_ORDER_* values in this file.

CVM_CUSTOMER_PORT=8793
# Bind the FIPS /128 so the exit node can proxy to it. Default is loopback.
CVM_CUSTOMER_HOST=fd36:3c0f:d6f:8029:ea50:958b:672e:bb0

CVM_MENU_FILE=/etc/cvm/three-buddies-menu.json
CVM_RAIL_URL=https://mint.minibits.cash/Bitcoin
CVM_RAIL_PURPOSE=ok

# Card value in USD per EUR of venue bill:
#   1.1133 (ECB 2026-10-28) x 1.10 margin = 1.22463
# The 2fiat 8% top-up fee is charged on the sats invoice, not deducted from
# the card; this margin covers the issuer FX rate and errors.
CVM_USD_PER_EUR=1.22463
CVM_USD_PER_EUR_SOURCE="ECB 2026-10-28 1.1133 + 10% margin"
CVM_RAIL_CARD_ID=1ca031655b5d4c74a35e090b7979f7df

CVM_KIT_WALLET=/home/c08r4d0r/repos/cvm-service-kit/src/lnwallet.ts

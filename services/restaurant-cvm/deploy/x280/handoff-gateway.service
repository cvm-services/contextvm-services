[Unit]
Description=Captcha handoff gateway (token-scoped noVNC for venue checkout)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/repos/contextvm-services/services/restaurant-cvm
EnvironmentFile=%h/.hermes/cvm/handoff-gateway.env
ExecStart=/usr/bin/python3 %h/repos/contextvm-services/services/restaurant-cvm/tools/handoff_gateway.py
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=false
MemoryMax=256M

[Install]
WantedBy=default.target

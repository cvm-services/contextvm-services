{
  "tasks": {
    "test": "deno test --allow-read",
    "test:net": "deno test --allow-read --allow-net",
    "anchors": "deno run --allow-read venues/tools/menu_anchors.ts --check",
    "anchors:write": "deno run --allow-read --allow-write venues/tools/menu_anchors.ts --write",
    "venues:check": "python3 venues/tools/capture_menu.py --all --check",
    "verify": "deno task check && deno task test && deno task anchors && deno task venues:check",
    "fixture": "deno run --allow-read --allow-write tools/nosms_announcement.ts --fixture",
    "check-fixture": "deno run --allow-read tools/nosms_announcement.ts --check",
    "emit": "deno run --allow-read tools/nosms_announcement.ts --emit",
    "check": "deno check tools/emit-venue-announcement.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "vendor/",
      "docs/",
      "vocab/",
      "fixtures/",
      "evidence/",
      "venues/"
    ]
  },
  "lint": {
    "exclude": [
      "vendor/",
      "docs/",
      "vocab/",
      "fixtures/",
      "evidence/",
      "venues/"
    ]
  }
}
